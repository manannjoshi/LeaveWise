# Copy this file to .env.local and paste your TomTom API key.
TOMTOM_API_KEY=

# Optional: Groq natural-language trip entry and result explanations (server-only).
GROQ_API_KEY=

# Supabase Project Settings > API Keys (server-only secret key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate with: web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Long random value used to protect /api/cron/rechecks.
CRON_SECRET=
